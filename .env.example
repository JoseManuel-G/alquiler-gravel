# Copy the project's URL and PUBLIC publishable key from Supabase > Project Settings > API.
# Never use a secret/service_role key here. All NEXT_PUBLIC_* values reach the browser.
NEXT_PUBLIC_SUPABASE_URL=
NEXT_PUBLIC_SUPABASE_PUBLISHABLE_KEY=
# Optional legacy alternative: NEXT_PUBLIC_SUPABASE_ANON_KEY=
# Exact production origin, without trailing slash (also used by the sitemap).
NEXT_PUBLIC_SITE_URL=

# SERVER ONLY — configure only after approving costs. Never prefix these with NEXT_PUBLIC_.
# SUPABASE_SERVICE_ROLE_KEY=
# OPENAI_API_KEY=
# OPENAI_RESEARCH_MODEL=
# CRON_SECRET=
LEISURE_AUTOMATION_ENABLED=false
LEISURE_COST_APPROVED=false
# LEISURE_MONTHLY_BUDGET_USD=20
# LEISURE_JOB_RESERVATION_USD=0.15
# Domains whose terms/permission explicitly allow structured extraction; empty by default.
# LEISURE_EXTRACTION_DOMAINS=
